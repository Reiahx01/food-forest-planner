// Renovate config -- food-forest-planner
//
// Picked json5 over json so this file can carry comments explaining *why*
// each rule exists. Renovate reads both.
//
// Strategy: low-noise weekly batches, grouped by ecosystem, auto-merge for
// safe patches once CI is green. Major upgrades wait for a human.
//
// Docs: https://docs.renovatebot.com/configuration-options/
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // `config:recommended` is the modern starter (replaced `config:base` in
  // 2024). Includes Dependency Dashboard, sensible PR limits, lockfile
  // maintenance opt-out.
  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':semanticCommits',
    'group:monorepos',
    'group:recommended',
    'workarounds:all',
  ],

  // Sign-off: required by .github/workflows/dco.yml. Without this, every
  // Renovate PR fails the DCO check.
  // The "renovate[bot]" account is auto-substituted by the app.
  gitAuthor: 'renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>',
  commitMessageSuffix: '\n\nSigned-off-by: renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>',

  // PR title: keep the conventional-commits prefix (`fix(deps):` or
  // `chore(deps):`) so the changelog can be generated by type.
  commitMessagePrefix: 'chore(deps): ',
  semanticCommits: 'enabled',
  semanticCommitType: 'chore',
  semanticCommitScope: 'deps',

  // Run on Monday mornings -- batches up everything that landed during the
  // week into a small set of PRs to review with coffee.
  schedule: ['before 9am on monday'],
  timezone: 'America/Los_Angeles',

  // Cap concurrent open Renovate PRs at 5 so the issue tracker doesn't
  // drown. New updates queue on the Dependency Dashboard.
  prConcurrentLimit: 5,
  prHourlyLimit: 0, // unlimited per hour (within the weekly schedule)

  // Lockfile is the source of truth -- always update it alongside the
  // package.json bump.
  rangeStrategy: 'bump',

  // Group rules: one PR per logical cluster. Keeps review surface small.
  packageRules: [
    // ------------------------------------------------------------------
    // Auto-merge: patch + pin updates only, AFTER CI is green.
    // ------------------------------------------------------------------
    {
      matchUpdateTypes: ['patch', 'pin', 'digest'],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true, // uses GH's native auto-merge after checks
    },

    // ------------------------------------------------------------------
    // Group: TypeScript + ESLint ecosystem
    // (these break in lockstep -- review them together)
    // ------------------------------------------------------------------
    {
      groupName: 'typescript + eslint',
      matchPackagePatterns: [
        '^typescript$',
        '^typescript-eslint',
        '^@typescript-eslint/',
        '^eslint',
        '^@eslint/',
      ],
    },

    // ------------------------------------------------------------------
    // Group: testing stack (Vitest + Testing Library + jsdom)
    // ------------------------------------------------------------------
    {
      groupName: 'testing',
      matchPackagePatterns: [
        '^vitest$',
        '^@vitest/',
        '^@testing-library/',
        '^jsdom$',
        '^@vitejs/plugin-react$',
      ],
    },

    // ------------------------------------------------------------------
    // Group: Next.js + React core (NEVER auto-merge; major versions move
    // the entire ecosystem)
    // ------------------------------------------------------------------
    {
      groupName: 'next + react',
      matchPackagePatterns: ['^next$', '^@next/', '^react$', '^react-dom$', '^@types/react'],
      automerge: false,
      labels: ['dep:framework', 'needs-triage'],
    },

    // ------------------------------------------------------------------
    // Group: Tailwind v4 (PostCSS plugin + core move together)
    // ------------------------------------------------------------------
    {
      groupName: 'tailwind',
      matchPackagePatterns: ['^tailwindcss$', '^@tailwindcss/'],
    },

    // ------------------------------------------------------------------
    // Major upgrades: open the PR but never auto-merge, regardless of
    // group. Force human review.
    // ------------------------------------------------------------------
    {
      matchUpdateTypes: ['major'],
      automerge: false,
      labels: ['dep:major', 'needs-triage'],
      prPriority: -1, // queue behind patches/minors
    },

    // ------------------------------------------------------------------
    // GitHub Actions: weekly batch, auto-merge minor + patch.
    // ------------------------------------------------------------------
    {
      matchManagers: ['github-actions'],
      groupName: 'github-actions',
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },
  ],

  // Vulnerability alerts: bypass the schedule and PR limits. Open
  // immediately, label loudly.
  vulnerabilityAlerts: {
    enabled: true,
    labels: ['security', 'needs-triage'],
    automerge: false,
    schedule: ['at any time'],
  },

  // Lockfile maintenance: refresh package-lock.json monthly even without
  // dep updates -- prevents long-lived lockfile drift.
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 9am on the first day of the month'],
    automerge: true,
  },
}
