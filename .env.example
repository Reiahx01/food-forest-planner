# food-forest-planner environment variables
#
# Copy to .env.local (gitignored) and fill in real values. The Next.js dev
# server auto-loads .env.local on boot. CI does NOT load this file -- the
# workflow injects only the vars it explicitly needs via `env:` blocks.
#
# Categories:
#   1. Supabase (database + auth) -- issue #4
#   2. Weather / climate data (NOAA) -- issue #19
#   3. Observability (Sentry, PostHog, Vercel Analytics) -- issue #26
#   4. Site origin (used by OG-image, sitemap, JSON-LD) -- always required
#
# A var with no v0.1.0 consumer is marked "(planned: #NN)" -- safe to leave
# blank until that issue ships.

# ----------------------------------------------------------------------------
# 1. Supabase  (planned: #4)
# ----------------------------------------------------------------------------
# Local dev: `npx supabase start` prints these. Use the local values for dev.
# Prod: Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only -- NEVER prefix with NEXT_PUBLIC_. Used by server actions /
# route handlers for privileged writes (e.g. admin-side seed mutations).
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# 2. NOAA climate-data token  (planned: #19)
# ----------------------------------------------------------------------------
# Request at https://www.ncdc.noaa.gov/cdo-web/token -- free, ~1 day turnaround.
# Used server-side only; rate-limited per token.
NOAA_API_TOKEN=

# ----------------------------------------------------------------------------
# 3. Observability  (planned: #26)
# ----------------------------------------------------------------------------
# Sentry: error + performance tracing. DSN is public-safe (NEXT_PUBLIC_).
NEXT_PUBLIC_SENTRY_DSN=
# Sentry auth token for sourcemap upload at build time -- server-only.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog: product analytics. Project API key is public-safe.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ----------------------------------------------------------------------------
# 4. Site origin (always required for prod build)
# ----------------------------------------------------------------------------
# Used by next-sitemap, OG image renderer, and JSON-LD `@id` URIs. Must be
# the absolute canonical origin (no trailing slash). Dev default works for
# local; prod build must set this to the production origin.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
